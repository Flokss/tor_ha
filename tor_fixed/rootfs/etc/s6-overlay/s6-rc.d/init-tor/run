#!/command/with-contenv bash
# shellcheck shell=bash

set -euo pipefail

# Reset torrc to clean state on every boot to prevent duplicate HiddenServiceDir blocks
if [ -f /etc/tor/torrc.sample ]; then
    cp -f /etc/tor/torrc.sample /etc/tor/torrc
fi

# Ensure hidden service directories exist
mkdir -p /etc/tor/hidden_service
mkdir -p /ssl/tor/hidden_service

# Generate torrc configuration
cat >> /etc/tor/torrc <<EOF

# Hidden Service Configuration
HiddenServiceDir /etc/tor/hidden_service
HiddenServiceVersion 3
HiddenServicePort 80 [::1]:8123
HiddenServicePort 443 [::1]:8123

# Bridge configuration (if provided)
${TOR_BRIDGE:-}

# Additional custom config
${TOR_CONFIG:-}
EOF

# Copy private key if it exists
if [ -f /ssl/tor/hidden_service/hostname ] && [ -f /ssl/tor/hidden_service/private_key ]; then
    cp -f /ssl/tor/hidden_service/hostname /etc/tor/hidden_service/hostname
    cp -f /ssl/tor/hidden_service/private_key /etc/tor/hidden_service/private_key
fi

echo "Tor init complete"
